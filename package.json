{
  "name": "checkout-lab",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "description": "Loja de exemplo com testes E2E e de API em Playwright.",
  "scripts": {
    "dev": "cross-env ENABLE_TEST_ENDPOINTS=true next dev",
    "build": "next build",
    "start": "next start",
    "start:test": "cross-env ENABLE_TEST_ENDPOINTS=true DB_FILE=data/test.db next start",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
